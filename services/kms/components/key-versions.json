{
  "schemaVersion": 1,
  "id": "key-versions",
  "label": "Customer managed customer master keys (CMK)",
  "selectors": [],
  "usageInputs": [
    {
      "id": "billableKeyVersions",
      "label": "Number of customer managed customer master keys (CMK)",
      "type": "number",
      "default": "5",
      "minimum": "0",
      "ui": {
        "help": "Matches the AWS Pricing Calculator KMS input for the number of customer managed CMKs. Key rotation versions are not entered separately in the Calculator screen."
      }
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "Encryption Key"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "Keys"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.billableKeyVersions"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "Keys"
  },
  "limitations": [
    "account-specific-discount"
  ]
}
