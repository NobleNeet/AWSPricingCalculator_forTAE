{
  "schemaVersion": 1,
  "id": "requests-standard",
  "label": "Symmetric requests",
  "selectors": [],
  "usageInputs": [
    {
      "id": "requests",
      "label": "Number of symmetric requests",
      "type": "number",
      "default": "2000000",
      "minimum": "0",
      "ui": {
        "help": "General KMS API requests billed by the standard request meter. The monthly free allowance is intentionally not subtracted."
      }
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "attributes.group",
        "op": "eq",
        "value": "awskms-APIRequest-All"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "Requests"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.requests"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "Requests"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount"
  ]
}
