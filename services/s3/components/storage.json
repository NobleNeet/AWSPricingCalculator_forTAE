{
  "schemaVersion": 1,
  "id": "storage",
  "label": "S3 Standard storage",
  "selectors": [],
  "usageInputs": [
    {
      "id": "gbMonths",
      "label": "GB-month",
      "type": "number",
      "default": "100",
      "minimum": "0"
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "usageType",
        "op": "in",
        "value": [
          "APN1-TimedStorage-ByteHrs",
          "APN2-TimedStorage-ByteHrs",
          "APN3-TimedStorage-ByteHrs",
          "APS1-TimedStorage-ByteHrs",
          "APS2-TimedStorage-ByteHrs",
          "APS3-TimedStorage-ByteHrs",
          "CAN1-TimedStorage-ByteHrs",
          "EUC1-TimedStorage-ByteHrs",
          "EUN1-TimedStorage-ByteHrs",
          "EU-TimedStorage-ByteHrs",
          "EUW2-TimedStorage-ByteHrs",
          "EUW3-TimedStorage-ByteHrs",
          "SAE1-TimedStorage-ByteHrs",
          "TimedStorage-ByteHrs",
          "USE2-TimedStorage-ByteHrs",
          "USW1-TimedStorage-ByteHrs",
          "USW2-TimedStorage-ByteHrs"
        ]
      },
      {
        "field": "productFamily",
        "op": "eq",
        "value": "Storage"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "GB-Mo"
      }
    ]
  },
  "calculation": {
    "model": "tiered",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.gbMonths"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "GB-Mo"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount",
    "network-transfer",
    "lifecycle-event-charge"
  ],
  "billingGroup": {
    "id": "s3-standard-storage",
    "scope": "plan-region",
    "policy": "tiered"
  },
  "ui": {
    "help": "同じPlan・RegionのS3 Standard使用量を合算して段階料金を計算します。見積もり外のアカウント使用量は含みません。行ごとの料金は行順に使用量を割り当てます。"
  }
}
