{
  "schemaVersion": 1,
  "id": "write-requests",
  "label": "PUT / COPY / POST / LIST",
  "selectors": [],
  "usageInputs": [
    {
      "id": "requests",
      "label": "Requests / month",
      "type": "number",
      "default": "1000",
      "minimum": "0"
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "usageType",
        "op": "in",
        "value": [
          "APN1-Requests-Tier1",
          "APN2-Requests-Tier1",
          "APN3-Requests-Tier1",
          "APS1-Requests-Tier1",
          "APS2-Requests-Tier1",
          "APS3-Requests-Tier1",
          "CAN1-Requests-Tier1",
          "EUC1-Requests-Tier1",
          "EUN1-Requests-Tier1",
          "EU-Requests-Tier1",
          "EUW2-Requests-Tier1",
          "EUW3-Requests-Tier1",
          "SAE1-Requests-Tier1",
          "Requests-Tier1",
          "USE2-Requests-Tier1",
          "USW1-Requests-Tier1",
          "USW2-Requests-Tier1"
        ]
      },
      {
        "field": "operation",
        "op": "eq",
        "value": ""
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "Requests"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.requests"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "Requests"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount"
  ]
}
