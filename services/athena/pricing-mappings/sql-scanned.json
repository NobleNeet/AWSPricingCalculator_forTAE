{
  "schemaVersion": 1,
  "id": "sql-scanned",
  "componentId": "sql-scanned",
  "priceSource": {
    "serviceCode": "AmazonAthena"
  },
  "productMatchers": [
    {
      "field": "productFamily",
      "op": "eq",
      "value": "Athena Queries"
    },
    {
      "field": "attributes.usagetype",
      "op": "regex",
      "value": "DataScannedInTB$"
    }
  ],
  "dimensionMatchers": [
    {
      "field": "unit",
      "op": "eq",
      "value": "Terabytes"
    }
  ],
  "expect": {
    "products": 1,
    "billableDimensions": 1
  },
  "notes": "Per-query rounding to MB and 10 MB minimum; GB shown in calculator, billing uses 1024 GiB per TiB. Exact AWS UI unit conversions remain to be tested."
}
