{
  "schemaVersion": 1,
  "id": "spark",
  "componentId": "spark",
  "priceSource": {
    "serviceCode": "AmazonAthena"
  },
  "productMatchers": [
    {
      "field": "productFamily",
      "op": "eq",
      "value": "Athena Spark"
    },
    {
      "field": "attributes.usagetype",
      "op": "regex",
      "value": "CodeExecutionInDPUHours$"
    }
  ],
  "dimensionMatchers": [
    {
      "field": "unit",
      "op": "eq",
      "value": "DPU-Hour"
    }
  ],
  "expect": {
    "products": 1,
    "billableDimensions": 1
  },
  "notes": "Spark execution DPU-hours; source screen accepts DPU hours per session."
}
