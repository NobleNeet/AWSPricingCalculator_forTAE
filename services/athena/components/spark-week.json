{
  "schemaVersion": 1,
  "id": "spark-week",
  "label": "スパーク (1週間)",
  "selectors": [],
  "usageInputs": [
    {
      "id": "sessionsPerMonth",
      "label": "スパークセッションの合計数 (件/週)",
      "type": "number",
      "default": "0",
      "minimum": "0",
      "integer": true
    },
    {
      "id": "dpuHoursPerSession",
      "label": "セッションあたりのコード実行 (DPU 時間)",
      "type": "number",
      "default": "0",
      "minimum": "0"
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "Athena Spark"
      },
      {
        "field": "operation",
        "op": "eq",
        "value": "Spark_Execution"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "DPU-Hour"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.sessionsPerMonth"
        },
        {
          "valueFrom": "component.dpuHoursPerSession"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [
      {
        "type": "scale",
        "factor": "4.333333333333333333333333333333"
      }
    ],
    "outputUnit": "DPU-Hour"
  },
  "limitations": [
    "account-specific-discount"
  ],
  "enabledWhen": {
    "field": "profile.sparkPeriod",
    "op": "eq",
    "value": "week"
  }
}
