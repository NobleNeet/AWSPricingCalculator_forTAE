{
  "schemaVersion": 1,
  "id": "instance",
  "label": "DB instance",
  "selectors": [
    {
      "id": "instanceType",
      "label": "DB instance type",
      "type": "select",
      "default": "db.t4g.micro",
      "options": {
        "attribute": "instanceType",
        "filters": []
      }
    }
  ],
  "usageInputs": [
    {
      "id": "hours",
      "label": "Hours / month",
      "type": "number",
      "default": "730",
      "minimum": "0",
      "exclusiveMinimum": "0",
      "maximum": "730",
      "ui": {
        "help": "1台あたりの月間稼働時間。0より大きく730時間以下。複数台の合計時間ではなく、台数を別に入力してください。"
      }
    },
    {
      "id": "quantity",
      "label": "DB instances",
      "type": "number",
      "default": "1",
      "minimum": "1",
      "integer": true,
      "ui": {
        "help": "稼働対象の台数を1以上の整数で入力してください。不要なサービスはPlanから外してください。"
      }
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "Database Instance"
      },
      {
        "field": "attributes.licenseModel",
        "op": "eq",
        "value": "No license required"
      },
      {
        "field": "attributes.instanceType",
        "op": "eq",
        "valueFrom": "component.instanceType"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "Hrs"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.hours"
        },
        {
          "valueFrom": "component.quantity"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "Hrs"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount",
    "cpu-credits",
    "aggregate-billing",
    "network-transfer",
    "extended-support"
  ]
}
