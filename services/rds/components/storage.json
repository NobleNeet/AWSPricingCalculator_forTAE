{
  "schemaVersion": 1,
  "id": "storage",
  "label": "gp3 database storage",
  "selectors": [],
  "usageInputs": [
    {
      "id": "gbMonths",
      "label": "GB-month",
      "type": "number",
      "default": "20",
      "minimum": "0",
      "exclusiveMinimum": "0",
      "ui": {
        "help": "DB全体の月間保存量（GB-month）。0より大きい値を入力するか、このComponentを無効にしてください。短期間利用の集計値へ実容量20GiBの下限を適用しません。"
      }
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "Database Storage"
      },
      {
        "field": "attributes.volumeType",
        "op": "eq",
        "value": "General Purpose-GP3"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "GB-Mo"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.gbMonths"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "GB-Mo"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount",
    "rds-extra-storage-performance",
    "backup-storage"
  ],
  "optional": true,
  "defaultEnabled": true
}
