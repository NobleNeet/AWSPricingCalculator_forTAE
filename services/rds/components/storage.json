{
  "schemaVersion": 1,
  "id": "storage",
  "label": "gp3 database storage",
  "selectors": [
    {
      "id": "usageMode",
      "label": "Usage input mode",
      "type": "select",
      "default": "capacity",
      "options": {
        "values": [
          "capacity",
          "aggregate"
        ]
      },
      "ui": {
        "help": "capacity: 物理容量と利用時間から計算。aggregate: 既知の月間合計使用量を直接入力します。"
      }
    }
  ],
  "usageInputs": [
    {
      "id": "gbMonths",
      "label": "GB-month",
      "type": "number",
      "default": "20",
      "minimum": "0",
      "exclusiveMinimum": "0",
      "ui": {
        "advanced": true,
        "help": "全DBの月間合計GB/月。同じDB台数・稼働時間で最低20 GiB/台を満たす必要があります。"
      },
      "enabledWhen": {
        "field": "component.usageMode",
        "op": "eq",
        "value": "aggregate"
      }
    },
    {
      "id": "capacityGb",
      "label": "Storage capacity per DB (GiB)",
      "type": "number",
      "default": "20",
      "minimum": "20",
      "maximum": "65536",
      "integer": true,
      "enabledWhen": {
        "field": "component.usageMode",
        "op": "eq",
        "value": "capacity"
      }
    },
    {
      "id": "storageHours",
      "label": "Storage duration (hours/month)",
      "type": "number",
      "default": "730",
      "exclusiveMinimum": "0",
      "maximum": "730",
      "enabledWhen": {
        "field": "component.usageMode",
        "op": "eq",
        "value": "capacity"
      }
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "Database Storage"
      },
      {
        "field": "attributes.volumeType",
        "op": "eq",
        "value": "General Purpose-GP3"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "GB-Mo"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "value": {
            "type": "choice",
            "field": "component.usageMode",
            "cases": {
              "aggregate": {
                "valueFrom": "component.gbMonths"
              },
              "capacity": {
                "value": {
                  "type": "product",
                  "sources": [
                    {
                      "valueFrom": "component.capacityGb"
                    },
                    {
                      "value": {
                        "type": "resolvedComponentInput",
                        "componentId": "instance",
                        "inputId": "quantity"
                      }
                    },
                    {
                      "value": {
                        "type": "transformed",
                        "source": {
                          "valueFrom": "component.storageHours"
                        },
                        "transforms": [
                          {
                            "type": "divide",
                            "divisor": "730"
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "GB-Mo"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount",
    "rds-extra-storage-performance",
    "backup-storage"
  ],
  "optional": true,
  "defaultEnabled": true,
  "constraints": [
    {
      "when": {
        "field": "component.usageMode",
        "op": "eq",
        "value": "capacity"
      },
      "left": {
        "valueFrom": "component.storageHours"
      },
      "op": "gte",
      "right": {
        "value": {
          "type": "resolvedComponentInput",
          "componentId": "instance",
          "inputId": "hours"
        }
      },
      "message": "ストレージ利用時間はDB稼働時間以上にしてください。"
    },
    {
      "when": {
        "field": "component.usageMode",
        "op": "eq",
        "value": "aggregate"
      },
      "left": {
        "valueFrom": "component.gbMonths"
      },
      "op": "gte",
      "right": {
        "value": {
          "type": "product",
          "sources": [
            {
              "value": "20"
            },
            {
              "value": {
                "type": "resolvedComponentInput",
                "componentId": "instance",
                "inputId": "quantity"
              }
            },
            {
              "value": {
                "type": "transformed",
                "source": {
                  "value": {
                    "type": "resolvedComponentInput",
                    "componentId": "instance",
                    "inputId": "hours"
                  }
                },
                "transforms": [
                  {
                    "type": "divide",
                    "divisor": "730"
                  }
                ]
              }
            }
          ]
        }
      },
      "message": "月間合計ストレージがDB台数・稼働時間に対する最小20 GiB/台を満たしていません。容量・利用時間モードで設定を確認してください。"
    }
  ]
}
