{
  "schemaVersion": 1,
  "categories": [
    {
      "filters": [
        {
          "field": "productFamily",
          "op": "eq",
          "value": "Database Instance"
        },
        {
          "field": "discriminators.databaseEngine",
          "op": "eq",
          "value": "Oracle"
        }
      ],
      "status": "mapped",
      "componentId": "instance"
    },
    {
      "filters": [
        {
          "field": "productFamily",
          "op": "eq",
          "value": "Database Storage"
        },
        {
          "field": "discriminators.databaseEngine",
          "op": "eq",
          "value": "Oracle"
        },
        {
          "field": "discriminators.volumeType",
          "op": "in",
          "value": [
            "General Purpose-GP3",
            "General Purpose"
          ]
        }
      ],
      "status": "mapped",
      "componentId": "storage-gp3"
    },
    {
      "filters": [
        {
          "field": "productFamily",
          "op": "eq",
          "value": "Storage Snapshot"
        },
        {
          "field": "discriminators.databaseEngine",
          "op": "eq",
          "value": "Oracle"
        },
        {
          "field": "operation",
          "op": "eq",
          "value": "CreateDBInstance:0005"
        }
      ],
      "status": "mapped",
      "componentId": "backup-storage"
    },
    {
      "filters": [
        {
          "field": "productFamily",
          "op": "eq",
          "value": "Storage Snapshot"
        },
        {
          "field": "discriminators.databaseEngine",
          "op": "eq",
          "value": "Oracle"
        },
        {
          "field": "operation",
          "op": "neq",
          "value": "CreateDBInstance:0005"
        }
      ],
      "status": "ignored",
      "reason": "Standard RDS Oracle uses canonical backup operation CreateDBInstance:0005; noncanonical legacy and RDS Custom snapshot meters must not be mapped to normal Oracle.",
      "limitationId": "unsupported-pricing-category"
    },
    {
      "filters": [
        {
          "field": "discriminators.databaseEngine",
          "op": "eq",
          "value": "Oracle"
        },
        {
          "field": "productFamily",
          "op": "notIn",
          "value": [
            "Database Instance",
            "Database Storage",
            "Storage Snapshot"
          ]
        }
      ],
      "status": "ignored",
      "reason": "Other Oracle-related RDS meters remain intentionally unsupported; see onboarding evidence.",
      "limitationId": "unsupported-pricing-category"
    },
    {
      "filters": [
        {
          "field": "discriminators.databaseEngine",
          "op": "eq",
          "value": "Oracle"
        },
        {
          "field": "productFamily",
          "op": "eq",
          "value": "Database Storage"
        },
        {
          "field": "discriminators.volumeType",
          "op": "notIn",
          "value": [
            "General Purpose-GP3",
            "General Purpose"
          ]
        }
      ],
      "status": "ignored",
      "reason": "The initial Oracle drawer supports gp3 database storage only. Other RDS for Oracle storage classes are not silently approximated.",
      "limitationId": "unsupported-pricing-category"
    },
    {
      "filters": [
        {
          "field": "discriminators.databaseEngine",
          "op": "notIn",
          "value": [
            "Oracle"
          ]
        }
      ],
      "status": "ignored",
      "reason": "The AmazonRDS price source is shared by multiple database engines and RDS features. Non-Oracle categories are outside the RDS for Oracle service package.",
      "limitationId": "unsupported-pricing-category"
    }
  ]
}
