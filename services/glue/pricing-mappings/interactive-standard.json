{
  "schemaVersion": 1,
  "id": "interactive-standard",
  "componentId": "interactive-standard",
  "priceSource": {
    "serviceCode": "AWSGlue"
  },
  "productMatchers": [
    {
      "field": "productFamily",
      "op": "eq",
      "value": "AWS Glue"
    },
    {
      "field": "attributes.group",
      "op": "eq",
      "valueFrom": "component.pricingGroup"
    }
  ],
  "dimensionMatchers": [
    {
      "field": "unit",
      "op": "eq",
      "value": "DPU-Hour"
    }
  ],
  "expect": {
    "products": 1,
    "billableDimensions": 1
  },
  "notes": "AWS Glue ETL Interactive Session Glue 6.0+ / ETL Interactive Session meter."
}
