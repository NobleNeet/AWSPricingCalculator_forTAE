{
  "schemaVersion": 1,
  "id": "data-quality",
  "componentId": "data-quality",
  "priceSource": {
    "serviceCode": "AWSGlue"
  },
  "productMatchers": [
    {
      "field": "productFamily",
      "op": "eq",
      "value": "AWS Glue"
    },
    {
      "field": "attributes.group",
      "op": "eq",
      "value": "ETL Job run"
    }
  ],
  "dimensionMatchers": [
    {
      "field": "unit",
      "op": "eq",
      "value": "DPU-Hour"
    }
  ],
  "expect": {
    "products": 1,
    "billableDimensions": 1
  },
  "notes": "AWS Glue Data Quality is DPU-priced but the Tokyo AWSGlue offer has no distinct Data Quality product; this intentionally reuses the standard ETL Job run DPU meter."
}
