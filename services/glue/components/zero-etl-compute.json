{
  "schemaVersion": 1,
  "id": "zero-etl-compute",
  "label": "AWS Glue zero-ETL compute",
  "selectors": [],
  "usageInputs": [
    {
      "id": "runsPerMonth",
      "label": "Runs per month",
      "type": "number",
      "default": "0",
      "minimum": "0",
      "integer": true
    },
    {
      "id": "dpusPerRun",
      "label": "DPUs per run",
      "type": "number",
      "default": "1",
      "minimum": "0"
    },
    {
      "id": "averageDurationMinutes",
      "label": "Average duration",
      "type": "number",
      "default": "1",
      "minimum": "0"
    }
  ],
  "fixedFilters": [
    {
      "field": "productFamily",
      "op": "eq",
      "value": "AWS Glue"
    }
  ],
  "priceQuery": {
    "productFilters": [
      {
        "field": "attributes.group",
        "op": "eq",
        "value": "ZETL Compute"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "DPU-Hour"
      }
    ],
    "expect": "singleSku"
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.runsPerMonth"
        },
        {
          "valueFrom": "component.dpusPerRun"
        },
        {
          "value": {
            "type": "transformed",
            "valueFrom": "component.averageDurationMinutes",
            "transforms": [
              {
                "type": "minimum",
                "value": "1"
              },
              {
                "type": "divide",
                "divisor": "60"
              }
            ]
          }
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "DPU-Hour"
  },
  "enabledWhen": {
    "all": [
      {
        "field": "profile.zeroEtl",
        "op": "eq",
        "value": true
      },
      {
        "field": "project.region",
        "op": "in",
        "value": [
          "ap-northeast-1",
          "us-east-1",
          "us-east-2",
          "us-west-2"
        ]
      }
    ]
  },
  "limitations": [
    "account-specific-discount"
  ]
}
