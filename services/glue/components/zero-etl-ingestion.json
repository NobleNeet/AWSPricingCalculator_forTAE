{
  "schemaVersion": 1,
  "id": "zero-etl-ingestion",
  "label": "AWS Glue zero-ETL ingestion",
  "selectors": [],
  "usageInputs": [
    {
      "id": "ingestedGbPerMonth",
      "label": "Data ingested per month (GB)",
      "type": "number",
      "default": "0",
      "minimum": "0"
    }
  ],
  "fixedFilters": [
    {
      "field": "productFamily",
      "op": "eq",
      "value": "AWS Glue"
    }
  ],
  "priceQuery": {
    "productFilters": [
      {
        "field": "attributes.group",
        "op": "eq",
        "value": "ZETL Ingestion"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "GB"
      }
    ],
    "expect": "singleSku"
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.ingestedGbPerMonth"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "GB"
  },
  "enabledWhen": {
    "all": [
      {
        "field": "profile.zeroEtl",
        "op": "eq",
        "value": true
      },
      {
        "field": "project.region",
        "op": "in",
        "value": [
          "ap-northeast-1",
          "us-east-1",
          "us-east-2",
          "us-west-2"
        ]
      }
    ]
  },
  "limitations": [
    "account-specific-discount"
  ]
}
