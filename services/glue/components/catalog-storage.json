{
  "schemaVersion": 1,
  "id": "catalog-storage",
  "label": "AWS Glue Data Catalog storage",
  "selectors": [],
  "usageInputs": [
    {
      "id": "objectsPerMonth",
      "label": "Objects stored per month",
      "type": "number",
      "default": "0",
      "minimum": "0"
    }
  ],
  "fixedFilters": [
    {
      "field": "productFamily",
      "op": "eq",
      "value": "AWS Glue"
    }
  ],
  "priceQuery": {
    "productFilters": [
      {
        "field": "attributes.group",
        "op": "eq",
        "value": "Data catalog storage"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "Obj-Month"
      }
    ],
    "expect": "singleSku"
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.objectsPerMonth"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "Obj-Month"
  },
  "enabledWhen": {
    "field": "profile.dataCatalog",
    "op": "eq",
    "value": true
  },
  "limitations": [
    "free-tier",
    "account-specific-discount"
  ]
}
