{
  "schemaVersion": 1,
  "id": "etl-standard",
  "label": "AWS Glue ETL jobs",
  "selectors": [
    {
      "id": "pricingGroup",
      "label": "Pricing mode",
      "type": "select",
      "default": "ETL Job Run Glue 6.0+",
      "options": {
        "values": [
          "ETL Job Run Glue 6.0+",
          "ETL Job run",
          "ETL Flex Job Run Glue 6.0+",
          "ETL Flex Job Run"
        ]
      },
      "ui": {
        "help": "AWS Public Price List の課金カテゴリを Glue のバージョン/実行クラスに対応させます。"
      }
    }
  ],
  "usageInputs": [
    {
      "id": "runsPerMonth",
      "label": "Runs per month",
      "type": "number",
      "default": "0",
      "minimum": "0",
      "integer": true
    },
    {
      "id": "dpusPerRun",
      "label": "DPUs per run",
      "type": "number",
      "default": "2",
      "minimum": "0"
    },
    {
      "id": "averageDurationMinutes",
      "label": "Average duration",
      "type": "number",
      "default": "1",
      "minimum": "0"
    }
  ],
  "fixedFilters": [
    {
      "field": "productFamily",
      "op": "eq",
      "value": "AWS Glue"
    }
  ],
  "priceQuery": {
    "productFilters": [
      {
        "field": "attributes.group",
        "op": "eq",
        "valueFrom": "component.pricingGroup"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "DPU-Hour"
      }
    ],
    "expect": "singleSku"
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.runsPerMonth"
        },
        {
          "valueFrom": "component.dpusPerRun"
        },
        {
          "value": {
            "type": "transformed",
            "valueFrom": "component.averageDurationMinutes",
            "transforms": [
              {
                "type": "minimum",
                "value": "1"
              }
            ]
          }
        }
      ],
      "combine": "multiply"
    },
    "transforms": [
      {
        "type": "unitConversion",
        "factor": "0.0166666666666666666666666666666667",
        "from": "DPU-Minute",
        "to": "DPU-Hour"
      }
    ],
    "outputUnit": "DPU-Hour"
  },
  "enabledWhen": {
    "field": "profile.etlJobs",
    "op": "eq",
    "value": true
  },
  "limitations": [
    "account-specific-discount"
  ]
}
