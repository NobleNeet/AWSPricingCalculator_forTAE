{
  "schemaVersion": 1,
  "id": "replayed-events",
  "componentId": "replayed-events",
  "priceSource": {
    "serviceCode": "AWSEvents"
  },
  "productMatchers": [
    {
      "field": "productFamily",
      "op": "eq",
      "value": "EventBridge"
    },
    {
      "field": "operation",
      "op": "eq",
      "value": "PutEvents"
    },
    {
      "field": "attributes.eventType",
      "op": "eq",
      "value": "Custom Event"
    }
  ],
  "dimensionMatchers": [
    {
      "field": "unit",
      "op": "eq",
      "value": "64K-Chunks"
    }
  ],
  "expect": {
    "products": 1,
    "billableDimensions": 1
  },
  "notes": "Event replay is billed at the classic custom event rate."
}
