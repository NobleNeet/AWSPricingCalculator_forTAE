{
  "schemaVersion": 1,
  "id": "custom-events-ingestion",
  "componentId": "custom-events-ingestion",
  "priceSource": {
    "serviceCode": "AWSEvents"
  },
  "productMatchers": [
    {
      "field": "productFamily",
      "op": "eq",
      "value": "EventBridge"
    },
    {
      "field": "operation",
      "op": "eq",
      "value": "PutEvents"
    },
    {
      "field": "attributes.eventType",
      "op": "eq",
      "value": "Custom Event"
    }
  ],
  "dimensionMatchers": [
    {
      "field": "unit",
      "op": "eq",
      "value": "64K-Chunks"
    }
  ],
  "expect": {
    "products": 1,
    "billableDimensions": 1
  },
  "notes": "Classic custom event ingestion meter."
}
