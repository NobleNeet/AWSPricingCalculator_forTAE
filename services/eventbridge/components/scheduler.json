{
  "schemaVersion": 1,
  "id": "scheduler",
  "label": "EventBridge Scheduler invocations",
  "selectors": [],
  "usageInputs": [],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "EventBridge"
      },
      {
        "field": "operation",
        "op": "eq",
        "value": "Invocation"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "Invocations"
      },
      {
        "field": "beginRange",
        "op": "eq",
        "value": "14000000"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "profile.schedulerInvocationsMillions"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [
      {
        "type": "scale",
        "factor": "1000000"
      }
    ],
    "outputUnit": "Invocations"
  },
  "limitations": [
    "account-specific-discount"
  ],
  "billingGroup": {
    "id": "scheduler-free-invocations",
    "scope": "plan",
    "policy": "allowance",
    "remainingFrom": "schedulerFreeInvocationsRemaining",
    "maximumAllowance": "14000000"
  },
  "ui": {
    "help": "Projectの残り無料呼び出し枠を同じPlanの全行・全Regionで共有します。見積もり外のアカウント使用量を差し引いた残り枠を設定してください。"
  }
}
