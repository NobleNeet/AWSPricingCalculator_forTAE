{
  "schemaVersion": 1,
  "id": "cross-account-custom-delivery",
  "label": "Cross-account custom event delivery",
  "selectors": [],
  "usageInputs": [],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "EventBridge"
      },
      {
        "field": "operation",
        "op": "eq",
        "value": "CrossAccountInvoke-CustomEvent"
      },
      {
        "field": "attributes.eventType",
        "op": "eq",
        "value": "Cross-Account Custom Event"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "64K-Chunks"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "profile.crossAccountCustomEventsMillions"
        },
        {
          "value": {
            "type": "transformed",
            "valueFrom": "profile.payloadSizeKb",
            "transforms": [
              {
                "type": "scale",
                "factor": "0.015625"
              },
              {
                "type": "rounding",
                "mode": "ceil"
              }
            ]
          }
        }
      ],
      "combine": "multiply"
    },
    "transforms": [
      {
        "type": "scale",
        "factor": "1000000"
      }
    ],
    "outputUnit": "64K-Chunks"
  },
  "limitations": [
    "account-specific-discount"
  ]
}
