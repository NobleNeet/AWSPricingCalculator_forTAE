{
  "schemaVersion": 1,
  "id": "archive-processing",
  "label": "Event replay archive processing",
  "selectors": [],
  "usageInputs": [],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "CloudWatch Events"
      },
      {
        "field": "operation",
        "op": "eq",
        "value": "ArchiveEvents"
      },
      {
        "field": "attributes.eventType",
        "op": "eq",
        "value": "Archive Event"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "GigaBytes"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "profile.archiveEventsMillions"
        },
        {
          "valueFrom": "profile.payloadSizeKb"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [
      {
        "type": "scale",
        "factor": "0.95367431640625"
      }
    ],
    "outputUnit": "GigaBytes"
  },
  "limitations": [
    "account-specific-discount"
  ],
  "ui": {
    "help": "EventBridge Classicの公開料金式に従い、KBを1024²でGBへ換算します。中間値は丸めません。公式Calculatorの中間丸めと推定される差により、小さいpayloadで表示額が異なる場合があります。処理対象イベント数と保存対象イベント数は独立し、既存Archiveの保存だけを見積もることもできます。"
  }
}
