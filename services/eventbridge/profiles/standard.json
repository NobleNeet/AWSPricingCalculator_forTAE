{
  "schemaVersion": 1,
  "id": "standard",
  "label": "EventBridge",
  "selectors": [
    {
      "id": "payloadSizeKb",
      "label": "Payload size (KB)",
      "type": "number",
      "default": "1",
      "minimum": "0.001",
      "ui": {
        "help": "Payload size used for EventBridge 64 KB chunk billing and Schema Discovery 8 KB chunk billing. The supplied AWS Calculator screenshot shows KB; unshown unit-dropdown alternatives are not inferred."
      }
    },
    {
      "id": "awsManagementEventsMillions",
      "label": "AWS management events (million / month)",
      "type": "number",
      "default": "0",
      "minimum": "0",
      "ui": {
        "help": "AWS management event ingestion is free on the classic event bus; the value is retained as an official Calculator input and does not add an ingestion charge."
      }
    },
    {
      "id": "awsOptInDataEventsMillions",
      "label": "AWS opt-in data events (million / month)",
      "type": "number",
      "default": "0",
      "minimum": "0"
    },
