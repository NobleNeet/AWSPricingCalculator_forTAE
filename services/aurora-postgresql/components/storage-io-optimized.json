{
  "schemaVersion": 1,
  "id": "storage-io-optimized",
  "label": "Aurora I/O-Optimized storage",
  "selectors": [],
  "usageInputs": [
    {
      "id": "gbMonths",
      "label": "GB-month",
      "type": "number",
      "default": "20",
      "minimum": "0"
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "Database Storage"
      },
      {
        "field": "attributes.volumeType",
        "op": "eq",
        "value": "IO Optimized-Aurora"
      },
      {
        "field": "usageType",
        "op": "in",
        "value": [
          "APN1-Aurora:StorageIOOptimizedUsage",
          "APN3-Aurora:StorageIOOptimizedUsage",
          "Aurora:StorageIOOptimizedUsage",
          "USE2-Aurora:StorageIOOptimizedUsage",
          "USW1-Aurora:StorageIOOptimizedUsage",
          "USW2-Aurora:StorageIOOptimizedUsage"
        ]
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "GB-Mo"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.gbMonths"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "GB-Mo"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount",
    "backup-storage"
  ]
}
