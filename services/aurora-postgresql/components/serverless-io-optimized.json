{
  "schemaVersion": 1,
  "id": "serverless-io-optimized",
  "label": "Serverless v2 compute",
  "selectors": [
    {
      "id": "usageMode",
      "label": "Usage input mode",
      "type": "select",
      "default": "capacity",
      "options": {
        "values": [
          "capacity",
          "aggregate"
        ]
      },
      "ui": {
        "help": "capacity: 物理容量と利用時間から計算。aggregate: 既知の月間合計使用量を直接入力します。"
      }
    }
  ],
  "usageInputs": [
    {
      "id": "acuHours",
      "label": "ACU-hours / month",
      "type": "number",
      "default": "730",
      "minimum": "0",
      "enabledWhen": {
        "field": "component.usageMode",
        "op": "eq",
        "value": "aggregate"
      },
      "ui": {
        "advanced": true,
        "help": "月間合計ACU時間です。短時間利用に通月容量の下限を適用しません。"
      }
    },
    {
      "id": "averageAcus",
      "label": "Average serverless capacity (ACUs)",
      "type": "number",
      "default": "1",
      "minimum": "0",
      "enabledWhen": {
        "field": "component.usageMode",
        "op": "eq",
        "value": "capacity"
      },
      "ui": {
        "help": "利用中の平均ACU。停止時間を平均に含める場合は利用時間と二重に控除しないでください。"
      }
    },
    {
      "id": "computeHours",
      "label": "Compute duration (hours/month)",
      "type": "number",
      "default": "730",
      "exclusiveMinimum": "0",
      "maximum": "730",
      "enabledWhen": {
        "field": "component.usageMode",
        "op": "eq",
        "value": "capacity"
      }
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "ServerlessV2"
      },
      {
        "field": "operation",
        "op": "eq",
        "value": "CreateDBInstance:0021"
      },
      {
        "field": "usageType",
        "op": "in",
        "value": [
          "APN1-Aurora:ServerlessV2IOOptimizedUsage",
          "APN3-Aurora:ServerlessV2IOOptimizedUsage",
          "Aurora:ServerlessV2IOOptimizedUsage",
          "USE2-Aurora:ServerlessV2IOOptimizedUsage",
          "USW1-Aurora:ServerlessV2IOOptimizedUsage",
          "USW2-Aurora:ServerlessV2IOOptimizedUsage"
        ]
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "ACU-Hr"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "value": {
            "type": "choice",
            "field": "component.usageMode",
            "cases": {
              "aggregate": {
                "valueFrom": "component.acuHours"
              },
              "capacity": {
                "value": {
                  "type": "product",
                  "sources": [
                    {
                      "valueFrom": "component.averageAcus"
                    },
                    {
                      "valueFrom": "component.computeHours"
                    }
                  ]
                }
              }
            }
          }
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "ACU-Hr"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount",
    "aggregate-billing",
    "network-transfer"
  ]
}
