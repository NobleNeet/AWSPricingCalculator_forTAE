{
  "schemaVersion": 1,
  "id": "serverless-standard",
  "label": "Serverless v2 compute",
  "selectors": [],
  "usageInputs": [
    {
      "id": "acuHours",
      "label": "ACU-hours / month",
      "type": "number",
      "default": "730",
      "minimum": "0"
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "ServerlessV2"
      },
      {
        "field": "operation",
        "op": "eq",
        "value": "CreateDBInstance:0021"
      },
      {
        "field": "usageType",
        "op": "in",
        "value": [
          "APN1-Aurora:ServerlessV2Usage",
          "APN3-Aurora:ServerlessV2Usage",
          "Aurora:ServerlessV2Usage",
          "USE2-Aurora:ServerlessV2Usage",
          "USW1-Aurora:ServerlessV2Usage",
          "USW2-Aurora:ServerlessV2Usage"
        ]
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "ACU-Hr"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.acuHours"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "ACU-Hr"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount",
    "aggregate-billing",
    "network-transfer"
  ]
}
