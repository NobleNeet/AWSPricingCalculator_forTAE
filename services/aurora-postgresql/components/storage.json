{
  "schemaVersion": 1,
  "id": "storage",
  "label": "Aurora storage",
  "selectors": [],
  "usageInputs": [
    {
      "id": "gbMonths",
      "label": "GB-month",
      "type": "number",
      "default": "20",
      "minimum": "0"
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {"field": "productFamily", "op": "eq", "value": "Database Storage"},
      {"field": "attributes.volumeType", "op": "eq", "value": "General Purpose-Aurora"}
    ],
    "dimensionFilters": [
      {"field": "unit", "op": "eq", "value": "GB-Mo"}
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {"sources": [{"valueFrom": "component.gbMonths"}], "combine": "multiply"},
    "transforms": [],
    "outputUnit": "GB-Mo"
  },
  "limitations": ["free-tier", "account-specific-discount"]
}
