{
  "schemaVersion": 1,
  "id": "limitless-compute",
  "label": "Aurora PostgreSQL Limitless compute",
  "selectors": [
    {
      "id": "usageMode",
      "label": "Usage input mode",
      "type": "select",
      "default": "capacity",
      "options": {
        "values": [
          "capacity",
          "aggregate"
        ]
      },
      "ui": {
        "help": "capacity: 物理容量と利用時間から計算。aggregate: 既知の月間合計使用量を直接入力します。"
      }
    }
  ],
  "usageInputs": [
    {
      "id": "acuHours",
      "label": "ACU-hours / month",
      "type": "number",
      "default": "11680",
      "minimum": "0",
      "ui": {
        "advanced": true,
        "help": "月間合計ACU時間です。短時間利用に通月容量の下限を適用しません。"
      },
      "enabledWhen": {
        "field": "component.usageMode",
        "op": "eq",
        "value": "aggregate"
      }
    },
    {
      "id": "averageAcus",
      "label": "Average DB shard group capacity (ACUs)",
      "type": "number",
      "default": "16",
      "minimum": "16",
      "enabledWhen": {
        "field": "component.usageMode",
        "op": "eq",
        "value": "capacity"
      },
      "ui": {
        "help": "基本構成の最小16 ACU。構成によって最小容量が増える場合はその容量を入力してください。監視ACUとは独立です。"
      }
    },
    {
      "id": "computeHours",
      "label": "Compute duration (hours/month)",
      "type": "number",
      "default": "730",
      "exclusiveMinimum": "0",
      "maximum": "730",
      "enabledWhen": {
        "field": "component.usageMode",
        "op": "eq",
        "value": "capacity"
      }
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "Limitless"
      },
      {
        "field": "attributes.databaseEngine",
        "op": "eq",
        "value": "Aurora PostgreSQL"
      },
      {
        "field": "attributes.storage",
        "op": "eq",
        "value": "Aurora IO Optimization Mode"
      },
      {
        "field": "operation",
        "op": "eq",
        "value": "CreateDBInstance:0021"
      },
      {
        "field": "attributes.limitlesspreview",
        "op": "notExists"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "ACU-Hr"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "value": {
            "type": "choice",
            "field": "component.usageMode",
            "cases": {
              "aggregate": {
                "valueFrom": "component.acuHours"
              },
              "capacity": {
                "value": {
                  "type": "product",
                  "sources": [
                    {
                      "valueFrom": "component.averageAcus"
                    },
                    {
                      "valueFrom": "component.computeHours"
                    }
                  ]
                }
              }
            }
          }
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "ACU-Hr"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount",
    "aggregate-billing",
    "network-transfer"
  ]
}
