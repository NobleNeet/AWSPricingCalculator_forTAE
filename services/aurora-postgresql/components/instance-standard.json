{
  "schemaVersion": 1,
  "id": "instance-standard",
  "label": "DB instance",
  "selectors": [
    {
      "id": "instanceType",
      "label": "DB instance type",
      "type": "select",
      "default": "db.t4g.medium",
      "options": {
        "attribute": "instanceType",
        "filters": []
      }
    }
  ],
  "usageInputs": [
    {
      "id": "hours",
      "label": "Hours / month",
      "type": "number",
      "default": "730",
      "minimum": "0"
    },
    {
      "id": "quantity",
      "label": "DB instances (writer + readers)",
      "type": "number",
      "default": "1",
      "minimum": "0"
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "Database Instance"
      },
      {
        "field": "attributes.licenseModel",
        "op": "eq",
        "value": "No license required"
      },
      {
        "field": "attributes.storage",
        "op": "neq",
        "value": "Aurora IO Optimization Mode"
      },
      {
        "field": "attributes.instanceType",
        "op": "eq",
        "valueFrom": "component.instanceType"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "Hrs"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.hours"
        },
        {
          "valueFrom": "component.quantity"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "Hrs"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount",
    "aggregate-billing",
    "network-transfer"
  ]
}
