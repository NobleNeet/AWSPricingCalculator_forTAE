{
  "schemaVersion": 1,
  "id": "database-insights-limitless",
  "label": "Aurora Limitless Database - Database Insights",
  "optional": true,
  "defaultEnabled": false,
  "selectors": [],
  "usageInputs": [
    {
      "id": "monitoredAcus",
      "label": "Database Insights monitored Aurora Capacity Units (ACUs)",
      "type": "number",
      "default": "0",
      "minimum": "0",
      "ui": {
        "help": "DB shard groupの容量とは独立した、Database Insightsの監視ACU数。0以上。DB容量の16 ACU下限を監視量へ適用しません。不要な場合はComponentを無効にできます。"
      }
    },
    {
      "id": "hours",
      "label": "Hours / month",
      "type": "number",
      "default": "730",
      "minimum": "0",
      "ui": {
        "advanced": true
      },
      "exclusiveMinimum": "0",
      "maximum": "730"
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "operation",
        "op": "eq",
        "value": "Aurora-PostgreSQL:Limitless"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "ACU-Hours"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.monitoredAcus"
        },
        {
          "valueFrom": "component.hours"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "ACU-Hours"
  },
  "limitations": [
    "account-specific-discount"
  ]
}
