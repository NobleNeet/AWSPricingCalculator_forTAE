{
  "schemaVersion": 1,
  "id": "ebs",
  "label": "Amazon Elastic Block Store (EBS)",
  "optional": true,
  "defaultEnabled": true,
  "selectors": [
    {
      "id": "volumeType",
      "label": "Storage volume",
      "type": "select",
      "default": "gp3",
      "options": {
        "values": [
          "gp3"
        ]
      },
      "ui": {
        "help": "EC2組み込みEBSでは、まず全リージョンで検証済みのgp3を扱います。他のEBSタイプは価格ディメンションと追加IOPS/throughput料金を含めて個別に検証してから追加します。"
      }
    }
  ],
  "usageInputs": [
    {
      "id": "storageGb",
      "label": "Storage amount (GB)",
      "type": "number",
      "default": "30",
      "minimum": "0",
      "ui": {
        "help": "AWS Pricing CalculatorのEC2見積りと同じく、既定値は30 GBです。0 GBでEBSを付けない見積りにできます。"
      }
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "Storage"
      },
      {
        "field": "attributes.volumeApiName",
        "op": "eq",
        "valueFrom": "component.volumeType"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "GB-Mo"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.storageGb"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "GB-Mo"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount"
  ]
}
