{
  "schemaVersion": 1,
  "id": "ebs",
  "label": "Amazon Elastic Block Store (EBS)",
  "optional": true,
  "defaultEnabled": true,
  "selectors": [
    {
      "id": "volumeType",
      "label": "Storage volume",
      "type": "select",
      "default": "gp3",
      "options": {
        "values": [
          "gp3",
          "gp2",
          "st1",
          "sc1"
        ]
      },
      "ui": {
        "help": "EC2組み込みEBSでは、ストレージ容量だけで月額を決定できるgp3（ベースライン性能）、gp2、st1、sc1を選択できます。gp3の追加IOPS/throughput、およびio1/io2のProvisioned IOPS料金は別メーター対応後に追加します。"
      }
    }
  ],
  "usageInputs": [
    {
      "id": "storageGb",
      "label": "Storage amount (GB)",
      "type": "number",
      "default": "30",
      "minimum": "0",
      "ui": {
        "help": "AWS Pricing CalculatorのEC2見積りと同じく、既定値は30 GBです。0 GBでEBSを付けない見積りにできます。"
      }
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "Storage"
      },
      {
        "field": "attributes.volumeApiName",
        "op": "eq",
        "valueFrom": "component.volumeType"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "GB-Mo"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.storageGb"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "GB-Mo"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount"
  ]
}
