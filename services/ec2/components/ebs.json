{
  "schemaVersion": 1,
  "id": "ebs",
  "label": "Amazon Elastic Block Store (EBS) storage",
  "selectors": [],
  "usageInputs": [
    {
      "id": "storageGb",
      "label": "Storage amount (GB)",
      "type": "number",
      "default": "30",
      "minimum": "0",
      "ui": {
        "help": "AWS Pricing CalculatorのEC2見積りと同じく、既定値は30 GBです。EBSを使用しない場合はEBS volume typeでnoneを選択します。"
      }
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "Storage"
      },
      {
        "field": "attributes.volumeApiName",
        "op": "eq",
        "valueFrom": "profile.ebsVolumeType"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "GB-Mo"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.storageGb"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "GB-Mo"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount"
  ],
  "enabledWhen": {
    "field": "profile.ebsVolumeType",
    "op": "neq",
    "value": "none"
  }
}
