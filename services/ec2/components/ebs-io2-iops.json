{
  "schemaVersion": 1,
  "id": "ebs-io2-iops",
  "label": "EBS io2 provisioned IOPS (tier 1)",
  "selectors": [],
  "usageInputs": [
    {
      "id": "provisionedIops",
      "label": "Provisioned IOPS",
      "type": "number",
      "default": "100",
      "minimum": "100",
      "maximum": "256000",
      "ui": {
        "help": "ボリューム1個あたりのIOPSです。32,000 / 64,000 IOPSの境界で段階料金を適用します。ストレージ容量の入力は全ボリュームの合計GB/月です。"
      }
    },
    {
      "id": "volumeCount",
      "label": "Number of io2 volumes",
      "type": "number",
      "default": "1",
      "minimum": "1",
      "integer": true
    },
    {
      "id": "volumeHours",
      "label": "io2 volume duration (hours/month)",
      "type": "number",
      "default": "730",
      "exclusiveMinimum": "0",
      "maximum": "730"
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "usageType",
        "op": "in",
        "value": [
          "APN1-EBS:VolumeP-IOPS.io2",
          "APN3-EBS:VolumeP-IOPS.io2",
          "EBS:VolumeP-IOPS.io2",
          "USE2-EBS:VolumeP-IOPS.io2",
          "USW1-EBS:VolumeP-IOPS.io2",
          "USW2-EBS:VolumeP-IOPS.io2"
        ]
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "IOPS-Mo"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "value": {
            "type": "transformed",
            "valueFrom": "component.provisionedIops",
            "transforms": [
              {
                "type": "maximum",
                "value": "32000"
              }
            ]
          }
        },
        {
          "valueFrom": "component.volumeCount"
        },
        {
          "value": {
            "type": "transformed",
            "valueFrom": "component.volumeHours",
            "transforms": [
              {
                "type": "divide",
                "divisor": "730"
              }
            ]
          }
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "IOPS-Mo"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount"
  ],
  "enabledWhen": {
    "field": "profile.ebsVolumeType",
    "op": "eq",
    "value": "io2"
  }
}
