{
  "schemaVersion": 1,
  "id": "instance",
  "label": "Compute instance",
  "selectors": [
    {
      "id": "instanceType",
      "label": "Instance type",
      "type": "select",
      "default": "t3.micro",
      "options": {
        "attribute": "instanceType",
        "filters": [
          {
            "field": "attributes.operatingSystem",
            "op": "eq",
            "valueFrom": "profile.os"
          },
          {
            "field": "attributes.tenancy",
            "op": "eq",
            "valueFrom": "profile.tenancy"
          },
          {
            "field": "attributes.preInstalledSw",
            "op": "eq",
            "valueFrom": "profile.software"
          }
        ]
      }
    }
  ],
  "usageInputs": [
    {
      "id": "hours",
      "label": "Expected utilization of EC2 instances (hours / month)",
      "type": "number",
      "default": "730",
      "minimum": "0",
      "maximum": "744",
      "ui": {
        "help": "AWS Pricing CalculatorのOn-Demand見積りに対応し、1インスタンスあたりの月間稼働時間を0〜744時間で直接入力します。RI/Savings Plans最適化用のWorkload（一定/日次/週次/月次スパイク）は本ツールでは扱いません。"
      }
    },
    {
      "id": "quantity",
      "label": "Number of EC2 instances",
      "type": "number",
      "default": "1",
      "minimum": "0"
    }
  ],
  "fixedFilters": [
    {
      "field": "productFamily",
      "op": "eq",
      "value": "Compute Instance"
    },
    {
      "field": "attributes.tenancy",
      "op": "eq",
      "valueFrom": "profile.tenancy"
    },
    {
      "field": "attributes.capacitystatus",
      "op": "eq",
      "value": "Used"
    },
    {
      "field": "attributes.preInstalledSw",
      "op": "eq",
      "valueFrom": "profile.software"
    },
    {
      "field": "attributes.marketoption",
      "op": "eq",
      "value": "OnDemand"
    },
    {
      "field": "attributes.licenseModel",
      "op": "eq",
      "value": "No License required"
    }
  ],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "attributes.operatingSystem",
        "op": "eq",
        "valueFrom": "profile.os"
      },
      {
        "field": "attributes.instanceType",
        "op": "eq",
        "valueFrom": "component.instanceType"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "Hrs"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.hours"
        },
        {
          "valueFrom": "component.quantity"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "Hrs"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount",
    "cpu-credits",
    "network-transfer",
    "aggregate-billing"
  ]
}
