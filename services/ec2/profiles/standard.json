{
  "schemaVersion": 1,
  "id": "standard",
  "label": "Standard",
  "selectors": [
    {
      "id": "tenancy",
      "label": "Tenancy",
      "type": "select",
      "default": "Shared",
      "options": {
        "values": [
          "Shared",
          "Dedicated"
        ]
      },
      "ui": {
        "help": "On-DemandのShared Instances / Dedicated Instancesを選択します。Dedicated Hostsはホスト単位課金のため別Profile相当として未対応です。"
      }
    },
    {
      "id": "os",
      "label": "Operating system",
      "type": "select",
      "default": "Linux",
      "options": {
        "attribute": "operatingSystem",
        "filters": [
          {
            "field": "productFamily",
            "op": "eq",
            "value": "Compute Instance"
          },
          {
            "field": "attributes.tenancy",
            "op": "eq",
            "valueFrom": "profile.tenancy"
          },
          {
            "field": "attributes.preInstalledSw",
            "op": "eq",
            "value": "NA"
          },
          {
            "field": "attributes.capacitystatus",
            "op": "eq",
            "value": "Used"
          },
          {
            "field": "attributes.marketoption",
            "op": "eq",
            "value": "OnDemand"
          },
          {
            "field": "attributes.licenseModel",
            "op": "eq",
            "value": "No License required"
          },
          {
            "field": "attributes.operatingSystem",
            "op": "neq",
            "value": "NA"
          }
        ]
      },
      "ui": {
        "help": "現在のRegion・TenancyでAWS Public Price Listに存在するOn-DemandのOS候補を表示します。"
      }
    },
    {
      "id": "software",
      "label": "Pre-installed software",
      "type": "select",
      "default": "NA",
      "options": {
        "attribute": "preInstalledSw",
        "filters": [
          {
            "field": "productFamily",
            "op": "eq",
            "value": "Compute Instance"
          },
          {
            "field": "attributes.tenancy",
            "op": "eq",
            "valueFrom": "profile.tenancy"
          },
          {
            "field": "attributes.operatingSystem",
            "op": "eq",
            "valueFrom": "profile.os"
          },
          {
            "field": "attributes.capacitystatus",
            "op": "eq",
            "value": "Used"
          },
          {
            "field": "attributes.marketoption",
            "op": "eq",
            "value": "OnDemand"
          },
          {
            "field": "attributes.licenseModel",
            "op": "eq",
            "value": "No License required"
          }
        ]
      },
      "ui": {
        "help": "AWS Public Price ListのpreInstalledSwを使用します。WindowsではNAのほかSQL Web / SQL Std / SQL Entなど、実際に存在する候補だけを表示します。"
      }
    },
    {
      "id": "ebsVolumeType",
      "label": "EBS volume type",
      "type": "select",
      "default": "gp3",
      "options": {
        "values": [
          "none",
          "gp3",
          "gp2",
          "st1",
          "sc1",
          "io1",
          "io2"
        ]
      },
      "ui": {
        "help": "EC2組み込みEBSのボリューム種別です。noneでEBS料金を除外します。gp3では追加IOPS/throughput、io1/io2ではProvisioned IOPSも別課金メーターとして計算します。"
      }
    }
  ],
  "fixedFilters": [],
  "components": [
    "instance",
    "ebs",
    "ebs-gp3-iops",
    "ebs-gp3-throughput",
    "ebs-io1-iops",
    "ebs-io2-iops"
  ]
}
