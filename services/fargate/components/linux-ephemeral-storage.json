{
  "schemaVersion": 1,
  "id": "linux-ephemeral-storage",
  "label": "Additional ephemeral storage (Linux)",
  "selectors": [],
  "usageInputs": [],
  "fixedFilters": [],
  "enabledWhen": {
    "field": "profile.operatingSystem",
    "op": "eq",
    "value": "Linux"
  },
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "Compute"
      },
      {
        "field": "attributes.storagetype",
        "op": "eq",
        "value": "default"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "GB-Hours"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "profile.tasksPerDay"
        },
        {
          "value": {
            "type": "transformed",
            "valueFrom": "project.hoursPerMonth",
            "transforms": [
              {
                "type": "scale",
                "factor": "0.041666666666666666666666666666666666666666666666666666666666666666666666666666667"
              }
            ]
          }
        },
        {
          "value": {
            "type": "transformed",
            "valueFrom": "profile.averageDurationHours",
            "transforms": [
              {
                "type": "minimum",
                "value": "0.0166666666666667"
              }
            ]
          }
        },
        {
          "value": {
            "type": "transformed",
            "valueFrom": "profile.ephemeralStorageGb",
            "transforms": [
              {
                "type": "subtract",
                "value": "20"
              },
              {
                "type": "minimum",
                "value": "0"
              }
            ]
          }
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "GB-Hours"
  },
  "limitations": [
    "account-specific-discount"
  ]
}
