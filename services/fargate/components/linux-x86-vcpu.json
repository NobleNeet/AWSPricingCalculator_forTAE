{
  "schemaVersion": 1,
  "id": "linux-x86-vcpu",
  "label": "Linux x86 vCPU",
  "selectors": [],
  "usageInputs": [],
  "fixedFilters": [],
  "enabledWhen": {
    "all": [
      {
        "field": "profile.operatingSystem",
        "op": "eq",
        "value": "Linux"
      },
      {
        "field": "profile.cpuArchitecture",
        "op": "eq",
        "value": "x86"
      }
    ]
  },
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "Compute"
      },
      {
        "field": "attributes.cputype",
        "op": "eq",
        "value": "perCPU"
      },
      {
        "field": "attributes.cpuArchitecture",
        "op": "notExists"
      },
      {
        "field": "attributes.operatingSystem",
        "op": "notExists"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "hours"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "profile.tasksPerDay"
        },
        {
          "value": {
            "type": "transformed",
            "valueFrom": "project.hoursPerMonth",
            "transforms": [
              {
                "type": "scale",
                "factor": "0.041666666666666666666666666666666666666666666666666666666666666666666666666666667"
              }
            ]
          }
        },
        {
          "value": {
            "type": "transformed",
            "valueFrom": "profile.averageDurationHours",
            "transforms": [
              {
                "type": "minimum",
                "value": "0.0166666666666667"
              }
            ]
          }
        },
        {
          "valueFrom": "profile.linuxVcpuPerTask"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "hours"
  },
  "limitations": [
    "account-specific-discount"
  ]
}
