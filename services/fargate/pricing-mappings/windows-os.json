{
  "schemaVersion": 1,
  "id": "windows-os",
  "componentId": "windows-os",
  "priceSource": {
    "serviceCode": "AmazonECS"
  },
  "productMatchers": [
    {
      "field": "productFamily",
      "op": "eq",
      "value": "Compute"
    },
    {
      "field": "attributes.operatingSystem",
      "op": "eq",
      "value": "Windows"
    },
    {
      "field": "attributes.cputype",
      "op": "eq",
      "value": "perCPU OS License Fee"
    }
  ],
  "dimensionMatchers": [
    {
      "field": "unit",
      "op": "eq",
      "value": "hours"
    }
  ],
  "expect": {
    "products": 1,
    "billableDimensions": 1
  },
  "notes": "Windows Fargate OS license meter per vCPU-hour."
}
