{
  "schemaVersion": 1,
  "id": "standard",
  "label": "Lambda Functions",
  "selectors": [
    {
      "id": "architecture",
      "label": "Architecture",
      "type": "select",
      "default": "AWS-Lambda-Duration",
      "options": { "values": ["AWS-Lambda-Duration", "AWS-Lambda-Duration-ARM"] },
      "ui": { "optionLabels": { "AWS-Lambda-Duration": "x86", "AWS-Lambda-Duration-ARM": "arm64" } }
    },
    {
      "id": "requestsPerMonth",
      "label": "Requests / month",
      "type": "number",
      "default": "1000000",
      "minimum": "0",
      "ui": { "help": "Requests executed without Provisioned Concurrency. Free Tier is intentionally not subtracted by this calculator." }
    },
    {
      "id": "averageDurationMs",
      "label": "Average duration / request (ms)",
      "type": "number",
      "default": "100",
      "minimum": "0",
      "maximum": "900000",
      "ui": { "help": "Average billed execution duration for on-demand invocations in milliseconds." }
    },
    {
      "id": "memoryMb",
      "label": "Memory (MB)",
      "type": "number",
      "default": "128",
      "minimum": "128",
      "maximum": "10240",
      "ui": { "help": "Configured function memory. The same function configuration is used for on-demand, Provisioned Concurrency, and SnapStart pricing." }
    },
    {
      "id": "ephemeralStorageMb",
      "label": "Ephemeral storage (MB)",
      "type": "number",
      "default": "512",
      "minimum": "512",
      "maximum": "10240",
      "ui": {
        "advanced": true,
        "help": "Total configured ephemeral storage. Lambda includes the first 512 MB at no additional charge; only the amount above 512 MB is billed."
      }
    },
    {
      "id": "provisionedConcurrency",
      "label": "Provisioned concurrency",
      "type": "number",
      "default": "0",
      "minimum": "0",
      "ui": {
        "advanced": true,
        "help": "Number of pre-initialized execution environments configured for Provisioned Concurrency. SnapStart and Provisioned Concurrency cannot be enabled on the same function version."
      }
    },
    {
      "id": "provisionedHoursPerMonth",
      "label": "Provisioned concurrency enabled hours / month",
      "type": "number",
      "default": "0",
      "minimum": "0",
      "maximum": "730",
      "enabledWhen": { "field": "profile.provisionedConcurrency", "op": "neq", "value": "0" },
      "ui": { "advanced": true, "help": "Total billed time that Provisioned Concurrency is enabled during the month. AWS bills each enabled period with five-minute rounding; enter the resulting aggregate billed hours when schedules are fragmented." }
    },
    {
      "id": "provisionedRequestsPerMonth",
      "label": "Requests using Provisioned Concurrency / month",
      "type": "number",
      "default": "0",
      "minimum": "0",
      "enabledWhen": { "field": "profile.provisionedConcurrency", "op": "neq", "value": "0" },
      "ui": { "advanced": true, "help": "Requests handled while Provisioned Concurrency is enabled. Spillover requests should be included in the on-demand request inputs instead." }
    },
    {
      "id": "provisionedAverageDurationMs",
      "label": "Provisioned average duration / request (ms)",
      "type": "number",
      "default": "100",
      "minimum": "0",
      "maximum": "900000",
      "enabledWhen": { "field": "profile.provisionedConcurrency", "op": "neq", "value": "0" },
      "ui": { "advanced": true, "help": "Average billed duration for requests executed with Provisioned Concurrency." }
    },
    {
      "id": "streamingRequestsPerMonth",
      "label": "HTTP response streaming requests / month",
      "type": "number",
      "default": "0",
      "minimum": "0",
      "ui": {
        "advanced": true,
        "help": "Number of invocations that return an HTTP response stream. These requests are still included in the normal Lambda request and duration inputs; this field adds only the response-stream data charge."
      }
    },
    {
      "id": "averageStreamedResponseMb",
      "label": "Average streamed response size / request (MB)",
      "type": "number",
      "default": "6",
      "minimum": "0",
      "maximum": "200",
      "enabledWhen": { "field": "profile.streamingRequestsPerMonth", "op": "neq", "value": "0" },
      "ui": {
        "advanced": true,
        "help": "Average response payload size for streaming invocations. AWS does not charge the first 6 MB written to the response stream for each request; only the excess is priced here."
      }
    },
    {
      "id": "snapStartMode",
      "label": "SnapStart pricing mode",
      "type": "select",
      "default": "disabled",
      "enabledWhen": {
        "all": [
          { "field": "profile.provisionedConcurrency", "op": "eq", "value": "0" },
          { "field": "profile.ephemeralStorageMb", "op": "eq", "value": "512" }
        ]
      },
      "options": { "values": ["disabled", "java-managed-no-charge", "billable-runtime"] },
      "ui": {
        "advanced": true,
        "optionLabels": {
          "disabled": "Disabled",
          "java-managed-no-charge": "Java managed runtime (no additional SnapStart charge)",
          "billable-runtime": "Billable SnapStart runtime"
        },
        "help": "Use Java managed runtime for supported Java runtimes with no additional SnapStart charge. Billable SnapStart cannot be combined with Provisioned Concurrency or ephemeral storage above 512 MB."
      }
    },
    {
      "id": "snapStartCachedVersionHours",
      "label": "SnapStart cached version-hours / month",
      "type": "number",
      "default": "3",
      "minimum": "3",
      "enabledWhen": { "field": "profile.snapStartMode", "op": "eq", "value": "billable-runtime" },
      "ui": {
        "advanced": true,
        "help": "Sum billed cache time across active published SnapStart versions. AWS bills each version for at least three hours and then per millisecond while active."
      }
    },
    {
      "id": "snapStartRestoresPerMonth",
      "label": "SnapStart restores / month",
      "type": "number",
      "default": "0",
      "minimum": "0",
      "enabledWhen": { "field": "profile.snapStartMode", "op": "eq", "value": "billable-runtime" },
      "ui": {
        "advanced": true,
        "help": "Number of execution-environment restores from the cached snapshot during the month."
      }
    }
  ],
  "fixedFilters": [
    { "field": "productFamily", "op": "eq", "value": "Serverless" }
  ],
  "components": [
    "requests",
    "duration",
    "ephemeral-storage-x86",
    "ephemeral-storage-arm",
    "provisioned-requests",
    "provisioned-duration-x86",
    "provisioned-duration-arm",
    "provisioned-capacity-x86",
    "provisioned-capacity-arm",
    "provisioned-ephemeral-storage-x86",
    "provisioned-ephemeral-storage-arm",
    "response-streaming-x86",
    "response-streaming-arm",
    "snapstart-cache",
    "snapstart-restore"
  ]
}
