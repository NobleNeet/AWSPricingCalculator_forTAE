{
  "schemaVersion": 1,
  "id": "standard",
  "label": "Lambda Functions",
  "selectors": [
    {
      "id": "architecture",
      "label": "Architecture",
      "type": "select",
      "default": "AWS-Lambda-Duration",
      "options": { "values": ["AWS-Lambda-Duration", "AWS-Lambda-Duration-ARM"] },
      "ui": { "help": "Processor architecture for the Lambda Functions section. Pricing is resolved from the corresponding x86 or Arm Public Price List meter." }
    },
    {
      "id": "ephemeralStorageMb",
      "label": "Amount of ephemeral storage allocated (MB)",
      "type": "number",
      "default": "512",
      "minimum": "512",
      "maximum": "10240",
      "ui": { "help": "Configured /tmp storage. The first 512 MB is included; only storage above 512 MB is billed." }
    },
    {
      "id": "requestsPerMonth",
      "label": "Number of requests / month",
      "type": "number",
      "default": "0",
      "minimum": "0",
      "ui": { "help": "Monthly Lambda function requests. Free Tier allowances are intentionally not subtracted by this calculator." }
    },
    {
      "id": "averageDurationMs",
      "label": "Duration of each request (ms)",
      "type": "number",
      "default": "100",
      "minimum": "0",
      "maximum": "900000",
      "ui": { "help": "Average billed execution duration in milliseconds." }
    },
    {
      "id": "memoryMb",
      "label": "Amount of memory allocated (MB)",
      "type": "number",
      "default": "128",
      "minimum": "128",
      "maximum": "10240",
      "ui": { "help": "Configured function memory, from 128 MB through 10,240 MB." }
    },
    {
      "id": "provisionedArchitecture",
      "label": "Provisioned Concurrency architecture",
      "type": "select",
      "default": "AWS-Lambda-Provisioned-Concurrency",
      "options": { "values": ["AWS-Lambda-Provisioned-Concurrency", "AWS-Lambda-Provisioned-Concurrency-ARM"] },
      "ui": { "advanced": true, "help": "Processor architecture for the Provisioned Concurrency section. This is independent from the Lambda Functions section in the AWS Pricing Calculator." }
    },
    {
      "id": "provisionedConcurrency",
      "label": "Provisioned concurrency",
      "type": "number",
      "default": "0",
      "minimum": "0",
      "ui": { "advanced": true, "help": "Number of pre-initialized execution environments." }
    },
    {
      "id": "provisionedHoursPerMonth",
      "label": "Provisioned Concurrency enabled hours / month",
      "type": "number",
      "default": "0",
      "minimum": "0",
      "maximum": "730",
      "enabledWhen": { "field": "profile.provisionedConcurrency", "op": "neq", "value": "0" },
      "ui": { "advanced": true, "help": "Total time Provisioned Concurrency is enabled during the month. AWS bills the enabled period rounded up to the nearest five minutes." }
    },
    {
      "id": "provisionedRequestsPerMonth",
      "label": "Number of provisioned requests / month",
      "type": "number",
      "default": "0",
      "minimum": "0",
      "enabledWhen": { "field": "profile.provisionedConcurrency", "op": "neq", "value": "0" },
      "ui": { "advanced": true, "help": "Requests executed while Provisioned Concurrency is enabled. The Lambda Free Tier does not apply to these functions." }
    },
    {
      "id": "provisionedAverageDurationMs",
      "label": "Duration of each provisioned request (ms)",
      "type": "number",
      "default": "100",
      "minimum": "0",
      "maximum": "900000",
      "enabledWhen": { "field": "profile.provisionedRequestsPerMonth", "op": "neq", "value": "0" },
      "ui": { "advanced": true, "help": "Average billed duration for requests executed with Provisioned Concurrency." }
    },
    {
      "id": "provisionedMemoryMb",
      "label": "Provisioned Concurrency memory allocated (MB)",
      "type": "number",
      "default": "128",
      "minimum": "128",
      "maximum": "10240",
      "enabledWhen": { "field": "profile.provisionedConcurrency", "op": "neq", "value": "0" },
      "ui": { "advanced": true, "help": "Memory allocation used by the Provisioned Concurrency estimate." }
    },
    {
      "id": "invokeMode",
      "label": "Invoke mode",
      "type": "select",
      "default": "buffered",
      "options": { "values": ["buffered", "response-stream"] },
      "ui": { "help": "Buffered responses have no additional response-streaming charge. Choose response-stream to estimate HTTP response streaming processed bytes." }
    },
    {
      "id": "averageStreamedResponseMb",
      "label": "Average streamed response size / request (MB)",
      "type": "number",
      "default": "6",
      "minimum": "0",
      "maximum": "200",
      "enabledWhen": { "field": "profile.invokeMode", "op": "eq", "value": "response-stream" },
      "ui": { "help": "For response streaming, the first 6 MB written per request is not charged by the processed-bytes meter." }
    }
  ],
  "fixedFilters": [
    { "field": "productFamily", "op": "eq", "value": "Serverless" }
  ],
  "components": [
    "requests",
    "duration",
    "ephemeral-storage-x86",
    "ephemeral-storage-arm",
    "provisioned-requests",
    "provisioned-duration-x86",
    "provisioned-duration-arm",
    "provisioned-capacity-x86",
    "provisioned-capacity-arm",
    "response-streaming-x86",
    "response-streaming-arm"
  ]
}
