{
  "schemaVersion": 1,
  "id": "duration",
  "componentId": "duration",
  "priceSource": { "serviceCode": "AWSLambda" },
  "productMatchers": [
    { "field": "productFamily", "op": "eq", "value": "Serverless" },
    { "field": "attributes.group", "op": "eq", "valueFrom": "profile.architecture" }
