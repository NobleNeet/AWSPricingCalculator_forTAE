  "dimensionMatchers": [
    { "field": "unit", "op": "eq", "value": "Lambda-GB-Second" }
  ],
  "expect": { "products": 1, "billableDimensions": 1 },
  "notes": "On-demand Lambda duration meter. The Calculator architecture selector chooses the corresponding x86 or Arm AWSLambda group."
}
