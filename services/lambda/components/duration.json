{
  "schemaVersion": 1,
  "id": "duration",
  "label": "Compute duration",
  "selectors": [],
  "usageInputs": [],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "attributes.group",
        "op": "eq",
        "valueFrom": "profile.architecture"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "Lambda-GB-Second"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "profile.requestsPerMonth"
        },
        {
          "valueFrom": "profile.averageDurationMs"
        },
        {
          "valueFrom": "profile.memoryMb"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [
      {
        "type": "scale",
        "factor": "0.0000009765625"
      }
    ],
    "outputUnit": "Lambda-GB-Second"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount",
    "aggregate-billing",
    "network-transfer",
    "organization-usage-aggregation"
  ]
}
