{
  "schemaVersion": 1,
  "id": "provisioned-ephemeral-storage-arm",
  "label": "Provisioned concurrency ephemeral storage",
  "selectors": [],
  "usageInputs": [],
  "fixedFilters": [],
  "enabledWhen": {
    "all": [
      { "field": "profile.architecture", "op": "eq", "value": "AWS-Lambda-Duration-ARM" },
      { "field": "profile.provisionedConcurrency", "op": "neq", "value": "0" },
      { "field": "profile.provisionedRequestsPerMonth", "op": "neq", "value": "0" },
      { "field": "profile.ephemeralStorageMb", "op": "neq", "value": "512" }
    ]
  },
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [ { "field": "attributes.group", "op": "eq", "value": "AWS-Lambda-Storage-Duration-ARM" } ],
    "dimensionFilters": [ { "field": "unit", "op": "eq", "value": "GB-Seconds" } ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        { "valueFrom": "profile.provisionedRequestsPerMonth" },
        { "valueFrom": "profile.provisionedAverageDurationMs" },
        { "value": { "type": "transformed", "valueFrom": "profile.ephemeralStorageMb", "transforms": [ { "type": "subtract", "value": "512" }, { "type": "minimum", "value": "0" } ] } }
      ],
      "combine": "multiply"
    },
    "transforms": [ { "type": "scale", "factor": "0.0000009765625" } ],
    "outputUnit": "GB-Seconds"
  },
  "limitations": ["account-specific-discount", "aggregate-billing"]
}
