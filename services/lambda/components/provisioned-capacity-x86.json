{
  "schemaVersion": 1,
  "id": "provisioned-capacity-x86",
  "label": "Provisioned concurrency capacity",
  "selectors": [],
  "usageInputs": [],
  "fixedFilters": [],
  "enabledWhen": {
    "field": "profile.architecture",
    "op": "eq",
    "value": "AWS-Lambda-Duration"
  },
  "optional": true,
  "defaultEnabled": false,
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      { "field": "attributes.group", "op": "eq", "value": "AWS-Lambda-Provisioned-Concurrency" }
    ],
    "dimensionFilters": [
      { "field": "unit", "op": "eq", "value": "Lambda-GB-Second" }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        { "valueFrom": "profile.provisionedConcurrency" },
        { "valueFrom": "profile.provisionedHoursPerMonth" },
        { "valueFrom": "profile.memoryMb" }
      ],
      "combine": "multiply"
    },
    "transforms": [
      { "type": "scale", "factor": "3.515625" }
    ],
    "outputUnit": "Lambda-GB-Second"
  },
  "limitations": ["account-specific-discount", "aggregate-billing"]
}
