{
  "schemaVersion": 1,
  "id": "provisioned-capacity-arm",
  "label": "Provisioned concurrency capacity",
  "selectors": [],
  "usageInputs": [],
  "fixedFilters": [],
  "enabledWhen": {
    "all": [
      { "field": "profile.provisionedArchitecture", "op": "eq", "value": "AWS-Lambda-Provisioned-Concurrency-ARM" },
      { "field": "profile.provisionedConcurrency", "op": "neq", "value": "0" },
      { "field": "profile.provisionedHoursPerMonth", "op": "neq", "value": "0" }
    ]
  },
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      { "field": "attributes.group", "op": "eq", "value": "AWS-Lambda-Provisioned-Concurrency-ARM" }
    ],
    "dimensionFilters": [
      { "field": "unit", "op": "eq", "value": "Lambda-GB-Second" }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        { "valueFrom": "profile.provisionedConcurrency" },
        { "valueFrom": "profile.provisionedHoursPerMonth" },
        { "valueFrom": "profile.provisionedMemoryMb" }
      ],
      "combine": "multiply"
    },
    "transforms": [
      { "type": "scale", "factor": "3.515625" }
    ],
    "outputUnit": "Lambda-GB-Second"
  },
  "limitations": ["account-specific-discount", "aggregate-billing"]
}
