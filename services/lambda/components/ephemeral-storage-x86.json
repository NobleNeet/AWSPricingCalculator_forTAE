{
  "schemaVersion": 1,
  "id": "ephemeral-storage-x86",
  "label": "On-demand ephemeral storage",
  "selectors": [],
  "usageInputs": [],
  "fixedFilters": [],
  "enabledWhen": {
    "field": "profile.architecture",
    "op": "eq",
    "value": "AWS-Lambda-Duration"
  },
  "optional": true,
  "defaultEnabled": false,
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      { "field": "attributes.group", "op": "eq", "value": "AWS-Lambda-Storage-Duration" }
    ],
    "dimensionFilters": [
      { "field": "unit", "op": "eq", "value": "GB-Seconds" }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        { "valueFrom": "profile.requestsPerMonth" },
        { "valueFrom": "profile.averageDurationMs" },
        { "valueFrom": "profile.additionalStorageMb" }
      ],
      "combine": "multiply"
    },
    "transforms": [
      { "type": "scale", "factor": "0.0000009765625" }
    ],
    "outputUnit": "GB-Seconds"
  },
  "limitations": ["account-specific-discount", "aggregate-billing"]
}
