{
  "schemaVersion": 1,
  "id": "requests",
  "label": "Invocations",
  "selectors": [],
  "usageInputs": [],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "attributes.group",
        "op": "eq",
        "value": "AWS-Lambda-Requests"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "in",
        "value": [
          "Request",
          "Requests"
        ]
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "profile.requestsPerMonth"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "Request"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount"
  ]
}
