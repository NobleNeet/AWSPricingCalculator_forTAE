{
  "schemaVersion": 1,
  "id": "iops",
  "label": "Additional provisioned IOPS",
  "selectors": [],
  "usageInputs": [
    {
      "id": "iopsMonths",
      "label": "Paid IOPS-month above included baseline",
      "type": "number",
      "default": "0",
      "minimum": "0",
      "ui": {
        "help": "Input only paid IOPS above the included 3,000 IOPS per volume; no Free Tier deduction is applied."
      }
    }
  ],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "usageType",
        "op": "in",
        "value": [
          "APN1-EBS:VolumeP-IOPS.gp3",
          "APN2-EBS:VolumeP-IOPS.gp3",
          "APN3-EBS:VolumeP-IOPS.gp3",
          "APS1-EBS:VolumeP-IOPS.gp3",
          "APS2-EBS:VolumeP-IOPS.gp3",
          "APS3-EBS:VolumeP-IOPS.gp3",
          "CAN1-EBS:VolumeP-IOPS.gp3",
          "EUC1-EBS:VolumeP-IOPS.gp3",
          "EUN1-EBS:VolumeP-IOPS.gp3",
          "EU-EBS:VolumeP-IOPS.gp3",
          "EUW2-EBS:VolumeP-IOPS.gp3",
          "EUW3-EBS:VolumeP-IOPS.gp3",
          "SAE1-EBS:VolumeP-IOPS.gp3",
          "EBS:VolumeP-IOPS.gp3",
          "USE2-EBS:VolumeP-IOPS.gp3",
          "USW1-EBS:VolumeP-IOPS.gp3",
          "USW2-EBS:VolumeP-IOPS.gp3"
        ]
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "IOPS-Mo"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "component.iopsMonths"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "IOPS-Mo"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount"
  ],
  "enabledWhen": {
    "field": "profile.volume",
    "op": "eq",
    "value": "gp3"
  }
}
