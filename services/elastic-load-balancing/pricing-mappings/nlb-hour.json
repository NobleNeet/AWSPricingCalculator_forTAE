{
  "schemaVersion": 1,
  "id": "nlb-hour",
  "componentId": "nlb-hour",
  "priceSource": {
    "serviceCode": "AWSELB"
  },
  "productMatchers": [
    {
      "field": "productFamily",
      "op": "eq",
      "value": "Load Balancer-Network"
    },
    {
      "field": "operation",
      "op": "eq",
      "value": "LoadBalancing:Network"
    },
    {
      "field": "attributes.groupDescription",
      "op": "eq",
      "value": "LoadBalancer hourly usage by Network Load Balancer"
    },
    {
      "field": "attributes.locationType",
      "op": "eq",
      "value": "AWS Region"
    }
  ],
  "dimensionMatchers": [
    {
      "field": "unit",
      "op": "eq",
      "value": "Hrs"
    }
  ],
  "expect": {
    "products": 1,
    "billableDimensions": 1
  }
}
