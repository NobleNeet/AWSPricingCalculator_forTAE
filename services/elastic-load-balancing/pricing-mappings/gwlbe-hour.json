{
  "schemaVersion": 1,
  "id": "gwlbe-hour",
  "componentId": "gwlbe-hour",
  "priceSource": {
    "serviceCode": "AmazonVPC"
  },
  "productMatchers": [
    {
      "field": "productFamily",
      "op": "eq",
      "value": "VpcEndpoint"
    },
    {
      "field": "operation",
      "op": "eq",
      "value": "VpcEndpoint"
    },
    {
      "field": "attributes.groupDescription",
      "op": "eq",
      "value": "Hourly charge for AWS Gateway Load Balancer VPC Endpoint"
    },
    {
      "field": "attributes.endpointType",
      "op": "eq",
      "value": "Gateway Load Balancer Endpoint"
    }
  ],
  "dimensionMatchers": [
    {
      "field": "unit",
      "op": "eq",
      "value": "Hrs"
    }
  ],
  "expect": {
    "products": 1,
    "billableDimensions": 1
  }
}
