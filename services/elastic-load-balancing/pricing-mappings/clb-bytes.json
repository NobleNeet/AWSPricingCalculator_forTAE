{
  "schemaVersion": 1,
  "id": "clb-bytes",
  "componentId": "clb-bytes",
  "priceSource": {
    "serviceCode": "AWSELB"
  },
  "productMatchers": [
    {
      "field": "productFamily",
      "op": "eq",
      "value": "Load Balancer"
    },
    {
      "field": "operation",
      "op": "eq",
      "value": "LoadBalancing"
    },
    {
      "field": "attributes.groupDescription",
      "op": "eq",
      "value": "Data processed by Classic Load Balancer"
    },
    {
      "field": "attributes.locationType",
      "op": "eq",
      "value": "AWS Region"
    }
  ],
  "dimensionMatchers": [
    {
      "field": "unit",
      "op": "eq",
      "value": "GB"
    }
  ],
  "expect": {
    "products": 1,
    "billableDimensions": 1
  }
}
