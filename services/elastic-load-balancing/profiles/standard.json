{
  "schemaVersion": 1,
  "id": "standard",
  "label": "Elastic Load Balancing",
  "selectors": [
    {
      "id": "albEnabled",
      "label": "Application Load Balancer を見積もりに含める",
      "type": "boolean",
      "default": true,
      "ui": {
        "sectionId": "alb",
        "sectionTitle": "Application Load Balancer"
      }
    },
    {
      "id": "albCount",
      "label": "Application Load Balancer の数",
      "type": "number",
      "default": "1",
      "minimum": "0",
      "ui": {
        "sectionId": "alb",
        "sectionTitle": "Application Load Balancer"
      },
      "enabledWhen": {
        "field": "profile.albEnabled",
        "op": "eq",
        "value": true
      }
    },
    {
      "id": "nlbEnabled",
      "label": "Network Load Balancer を見積もりに含める",
      "type": "boolean",
      "default": true,
      "ui": {
        "sectionId": "nlb",
        "sectionTitle": "Network Load Balancer"
      }
    },
    {
      "id": "nlbCount",
      "label": "Network Load Balancer の数",
      "type": "number",
      "default": "1",
      "minimum": "0",
