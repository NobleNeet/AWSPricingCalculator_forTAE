{
  "schemaVersion": 1,
  "id": "nlb-hour",
  "label": "Network Load Balancer 稼働時間",
  "selectors": [],
  "usageInputs": [],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "Load Balancer-Network"
      },
      {
        "field": "operation",
        "op": "eq",
        "value": "LoadBalancing:Network"
      },
      {
        "field": "attributes.groupDescription",
        "op": "eq",
        "value": "LoadBalancer hourly usage by Network Load Balancer"
      },
      {
        "field": "attributes.locationType",
        "op": "eq",
        "value": "AWS Region"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "Hrs"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "profile.nlbCount"
        },
        {
          "valueFrom": "project.hoursPerMonth"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "Hrs"
  },
  "limitations": [
    "account-specific-discount"
  ],
  "enabledWhen": {
    "field": "profile.nlbEnabled",
    "op": "eq",
    "value": true
  }
}
