{
  "schemaVersion": 1,
  "id": "nlb-tls",
  "label": "Network Load Balancer TLS NLCU",
  "selectors": [],
  "usageInputs": [],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "Load Balancer-Network"
      },
      {
        "field": "operation",
        "op": "eq",
        "value": "LoadBalancing:Network"
      },
      {
        "field": "attributes.groupDescription",
        "op": "eq",
        "value": "Used Network Load Balancer capacity units-hr"
      },
      {
        "field": "attributes.locationType",
        "op": "eq",
        "value": "AWS Region"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "LCU-Hrs"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "profile.nlbCount"
        },
        {
          "valueFrom": "project.hoursPerMonth"
        },
        {
          "value": {
            "type": "maximum",
            "sources": [
              {
                "value": {
                  "type": "transformed",
                  "source": {
                    "valueFrom": "profile.nlbtlsNew"
                  },
                  "transforms": [
                    {
                      "type": "divide",
                      "divisor": "50"
                    }
                  ]
                }
              },
              {
                "value": {
                  "type": "transformed",
                  "source": {
                    "value": {
                      "type": "product",
                      "sources": [
                        {
                          "valueFrom": "profile.nlbtlsNew"
                        },
                        {
                          "valueFrom": "profile.nlbtlsSeconds"
                        }
                      ]
                    }
                  },
                  "transforms": [
                    {
                      "type": "divide",
                      "divisor": "3000"
                    }
                  ]
                }
              },
              {
                "value": {
                  "type": "transformed",
                  "source": {
                    "value": {
                      "type": "product",
                      "sources": [
                        {
                          "valueFrom": "profile.nlbtlsNew"
                        },
                        {
                          "valueFrom": "profile.nlbtlsBytes"
                        },
                        {
                          "value": "3600"
                        }
                      ]
                    }
                  },
                  "transforms": [
                    {
                      "type": "divide",
                      "divisor": "1000000000"
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "LCU-Hrs"
  },
  "limitations": [
    "account-specific-discount",
    "network-transfer"
  ],
  "enabledWhen": {
    "field": "profile.nlbEnabled",
    "op": "eq",
    "value": true
  }
}
