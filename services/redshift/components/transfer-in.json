{
  "schemaVersion": 1,
  "id": "transfer-in",
  "label": "Redshift Data Transfer",
  "selectors": [],
  "usageInputs": [],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "Redshift Inter Region Data Transfer"
      },
      {
        "field": "attributes.usagetype",
        "op": "in",
        "value": [
          "APN1-Redshift:InterRegionDataSharing",
          "APN3-Redshift:InterRegionDataSharing",
          "USE1-Redshift:InterRegionDataSharing",
          "USE2-Redshift:InterRegionDataSharing",
          "USW1-Redshift:InterRegionDataSharing",
          "USW2-Redshift:InterRegionDataSharing"
        ]
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "GB"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "profile.transferInGb"
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "GB"
  },
  "limitations": [
    "account-specific-discount"
  ]
}
