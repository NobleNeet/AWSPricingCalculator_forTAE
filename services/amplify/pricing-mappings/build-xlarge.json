{
  "schemaVersion": 1,
  "id": "build-xlarge",
  "componentId": "build-xlarge",
  "priceSource": {
    "serviceCode": "AWSAmplify"
  },
  "productMatchers": [
    {
      "field": "productFamily",
      "op": "eq",
      "value": "AWS Amplify"
    },
    {
      "field": "attributes.instancetype",
      "op": "exists"
    },
    {
      "field": "attributes.instancetype",
      "op": "notIn",
      "value": [
        "Standard8GB",
        "Large16GB"
      ]
    }
  ],
  "dimensionMatchers": [
    {
      "field": "unit",
      "op": "eq",
      "value": "minutes"
    }
  ],
  "expect": {
    "products": 1,
    "billableDimensions": 1
  },
  "notes": "Amplify Hosting XLarge build minute meter. Match the non-Standard/non-Large build instance so current AWS Price List naming changes do not strand the XLarge meter."
}
