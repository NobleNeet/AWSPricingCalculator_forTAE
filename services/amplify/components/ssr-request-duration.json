{
  "schemaVersion": 1,
  "id": "ssr-request-duration",
  "label": "SSR request duration",
  "selectors": [],
  "usageInputs": [],
  "fixedFilters": [],
  "priceQuery": {
    "expect": "singleSku",
    "productFilters": [
      {
        "field": "productFamily",
        "op": "eq",
        "value": "AWS Amplify"
      },
      {
        "field": "operation",
        "op": "eq",
        "value": "HostingComputeRequestDuration"
      }
    ],
    "dimensionFilters": [
      {
        "field": "unit",
        "op": "eq",
        "value": "GB-Seconds"
      }
    ]
  },
  "calculation": {
    "model": "unit",
    "usage": {
      "sources": [
        {
          "valueFrom": "profile.ssrRequestsPerHour"
        },
        {
          "valueFrom": "project.hoursPerMonth"
        },
        {
          "value": {
            "type": "transformed",
            "valueFrom": "profile.ssrDurationMs",
            "transforms": [
              {
                "type": "scale",
                "factor": "0.001"
              }
            ]
          }
        }
      ],
      "combine": "multiply"
    },
    "transforms": [],
    "outputUnit": "GB-Seconds"
  },
  "limitations": [
    "free-tier",
    "account-specific-discount"
  ]
}
