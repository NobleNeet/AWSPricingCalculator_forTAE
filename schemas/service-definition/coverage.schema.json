{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "pattern": "^(productFamily|operation|usageTypeClass|unit|discriminators\\.[a-zA-Z][a-zA-Z0-9]*)$"
                },
                "op": {
                  "enum": [
                    "eq",
                    "neq",
                    "in",
                    "notIn",
                    "exists",
                    "notExists"
                  ]
                },
                "value": {},
                "valueFrom": {
                  "type": "string",
                  "pattern": "^(project|profile|component)\\.[a-zA-Z][a-zA-Z0-9-]*$"
                }
              },
              "required": [
                "field",
                "op"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "op": {
                        "enum": [
                          "eq",
                          "neq"
                        ]
                      }
                    }
                  },
                  "then": {
                    "oneOf": [
                      {
                        "required": [
                          "value"
                        ],
                        "not": {
                          "required": [
                            "valueFrom"
                          ]
                        }
                      },
                      {
                        "required": [
                          "valueFrom"
                        ],
                        "not": {
                          "required": [
                            "value"
                          ]
                        }
                      }
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "op": {
                        "enum": [
                          "in",
                          "notIn"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "value"
                    ],
                    "properties": {
                      "value": {
                        "type": "array"
                      }
                    },
                    "not": {
                      "required": [
                        "valueFrom"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "op": {
                        "enum": [
                          "exists",
                          "notExists"
                        ]
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "value"
                          ]
                        },
                        {
                          "required": [
                            "valueFrom"
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          "status": {
            "enum": [
              "mapped",
              "ignored",
              "unresolved"
            ]
          },
          "componentId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "limitationId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "required": [
          "filters",
          "status"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "mapped"
                }
              }
            },
            "then": {
              "required": [
                "componentId"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ignored"
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "categories"
  ],
  "additionalProperties": false
}
