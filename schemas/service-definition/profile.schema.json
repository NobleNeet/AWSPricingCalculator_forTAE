          },
          "default": {},
          "minimum": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?$"
              }
            ]
          },
          "maximum": {
            "oneOf": [
