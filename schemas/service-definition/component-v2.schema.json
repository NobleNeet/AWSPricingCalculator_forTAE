{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "label": { "type": "string", "minLength": 1 },
    "selectors": { "type": "array", "items": { "$ref": "#/$defs/input" } },
    "usageInputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
    "fixedFilters": { "type": "array", "items": { "$ref": "#/$defs/productFilter" } },
    "meters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "enabledWhen": { "$ref": "#/$defs/condition" },
          "priceQuery": { "$ref": "#/$defs/priceQuery" },
          "calculation": { "$ref": "#/$defs/calculation" },
          "limitations": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } }
        },
        "required": ["id", "label", "priceQuery", "calculation"],
        "additionalProperties": false
      }
    },
    "enabledWhen": { "$ref": "#/$defs/condition" },
    "optional": { "type": "boolean" },
    "defaultEnabled": { "type": "boolean" },
    "limitations": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
    "ui": {
      "type": "object",
      "properties": {
        "advanced": { "type": "boolean" },
        "help": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "id", "label", "selectors", "usageInputs", "fixedFilters", "meters", "limitations"],
  "additionalProperties": false,
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["number", "select", "boolean"] },
        "default": {},
        "minimum": { "$ref": "#/$defs/nonnegative" },
        "maximum": { "$ref": "#/$defs/nonnegative" },
        "enabledWhen": { "$ref": "#/$defs/condition" },
        "options": {
          "type": "object",
          "properties": {
            "attribute": { "type": "string", "minLength": 1 },
            "filters": { "type": "array", "items": { "$ref": "#/$defs/productFilter" } },
            "values": { "type": "array", "items": {} }
          },
          "additionalProperties": false
        },
        "ui": {
          "type": "object",
          "properties": {
            "advanced": { "type": "boolean" },
            "help": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "required": ["id", "label", "type"],
      "additionalProperties": false
    },
    "nonnegative": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" }
      ]
    },
    "productFilter": {
      "type": "object",
      "properties": {
        "field": { "type": "string", "pattern": "^(productFamily|operation|usageType|attributes\\.[a-zA-Z][a-zA-Z0-9]*)$" },
        "op": { "enum": ["eq", "neq", "in", "notIn", "exists", "notExists"] },
        "value": {},
        "valueFrom": { "type": "string", "pattern": "^(project|profile|component)\\.[a-zA-Z][a-zA-Z0-9-]*$" }
      },
      "required": ["field", "op"],
      "additionalProperties": false
    },
    "dimensionFilter": {
      "type": "object",
      "properties": {
        "field": { "enum": ["unit", "description", "beginRange", "endRange"] },
        "op": { "enum": ["eq", "neq", "in", "notIn", "exists", "notExists"] },
        "value": {},
        "valueFrom": { "type": "string", "pattern": "^(project|profile|component)\\.[a-zA-Z][a-zA-Z0-9-]*$" }
      },
      "required": ["field", "op"],
      "additionalProperties": false
    },
    "priceQuery": {
      "type": "object",
      "properties": {
        "productFilters": { "type": "array", "items": { "$ref": "#/$defs/productFilter" } },
        "dimensionFilters": { "type": "array", "items": { "$ref": "#/$defs/dimensionFilter" } },
        "expect": { "const": "singleSku" }
      },
      "required": ["productFilters", "dimensionFilters", "expect"],
      "additionalProperties": false
    },
    "usageSource": {
      "type": "object",
      "properties": {
        "value": {},
        "valueFrom": { "type": "string", "pattern": "^(project|profile|component)\\.[a-zA-Z][a-zA-Z0-9-]*$" }
      },
      "additionalProperties": false,
      "oneOf": [
        { "required": ["value"], "not": { "required": ["valueFrom"] } },
        { "required": ["valueFrom"], "not": { "required": ["value"] } }
      ]
    },
    "transform": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "type": { "enum": ["minimum", "increment"] }, "value": { "$ref": "#/$defs/nonnegative" } },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "const": "scale" }, "factor": { "$ref": "#/$defs/nonnegative" } },
          "required": ["type", "factor"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "unitConversion" },
            "factor": { "$ref": "#/$defs/nonnegative" },
            "from": { "type": "string", "minLength": 1 },
            "to": { "type": "string", "minLength": 1 }
          },
          "required": ["type", "factor", "from", "to"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "const": "rounding" }, "mode": { "const": "ceil" } },
          "required": ["type", "mode"],
          "additionalProperties": false
        }
      ]
    },
    "calculation": {
      "type": "object",
      "properties": {
        "model": { "const": "unit" },
        "usage": {
          "type": "object",
          "properties": {
            "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/usageSource" } },
            "combine": { "const": "multiply" }
          },
          "required": ["sources", "combine"],
          "additionalProperties": false
        },
        "transforms": { "type": "array", "items": { "$ref": "#/$defs/transform" } },
        "outputUnit": { "type": "string", "minLength": 1 }
      },
      "required": ["model", "usage", "transforms", "outputUnit"],
      "additionalProperties": false
    },
    "condition": {
      "oneOf": [
        { "type": "object", "properties": { "all": { "type": "array", "items": { "$ref": "#/$defs/condition" } } }, "required": ["all"], "additionalProperties": false },
        { "type": "object", "properties": { "any": { "type": "array", "items": { "$ref": "#/$defs/condition" } } }, "required": ["any"], "additionalProperties": false },
        { "type": "object", "properties": { "not": { "$ref": "#/$defs/condition" } }, "required": ["not"], "additionalProperties": false },
        {
          "type": "object",
          "properties": {
            "field": { "type": "string", "pattern": "^(project|profile|component)\\.[a-zA-Z][a-zA-Z0-9-]*$" },
            "op": { "enum": ["eq", "neq", "in", "notIn", "exists", "notExists"] },
            "value": {},
            "valueFrom": { "type": "string", "pattern": "^(project|profile|component)\\.[a-zA-Z][a-zA-Z0-9-]*$" }
          },
          "required": ["field", "op"],
          "additionalProperties": false
        }
      ]
    }
  }
}
